# URL koji klijent koristi za Valhallu.
# Puni https URL: preglednik zove poslužitelj izravno (javni OSM Valhalla ima CORS).
# /api/valhalla: promet ide preko proxyja u ovom projektu, a upstream je VALHALLA_URL.
# VITE_ varijable se ugrađuju tijekom `npm run build`.
VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de

# Upstreami za proxy (npm run dev / npm start / Cloudflare Worker / Vercel).
# Mogu se mijenjati bez ponovne gradnje samo ako klijent zove /api/valhalla.
VALHALLA_URL=https://valhalla1.openstreetmap.de
NEXTBIKE_URL=https://maps.nextbike.net/maps/nextbike-live.json?city=1172&domains=hd&list_cities=0&bikes=0
# Geokoder. Javni Photon (Komoot, OpenStreetMap) dopušta pretragu tijekom tipkanja i nema ključ.
# Kućni brojevi dolaze sa sloja layer=house. Javni Nominatim se ne koristi: ne dopušta autocomplete.
PHOTON_URL=https://photon.komoot.io
VITE_PHOTON_URL=https://photon.komoot.io
# Kućni brojevi Grada Zagreba (javni sloj, bez ključa). Photon ostaje za mjesta i ulice bez broja.
ZAGREB_ADDRESS_URL=https://arcportal.zagreb.hr/server/rest/services/DKPiRPJ/KBR_kućni_broj/MapServer/1/query
VITE_ZAGREB_ADDRESS_URL=https://arcportal.zagreb.hr/server/rest/services/DKPiRPJ/KBR_kućni_broj/MapServer/1/query
PORT=8787
